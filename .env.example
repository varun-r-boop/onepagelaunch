# Copy to .env.local and fill in your values. Never commit .env.local.

# Supabase: Project Settings → API Keys in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (replaces the legacy anon key). Safe for the browser; access is limited by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (replaces the legacy service_role key). Server-only, bypasses RLS. Never expose it.
# Required for Pro plans (billing webhook), analytics, and reliable waitlist sign-ups.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the app, used to build page links returned by the API
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Pro plan billing (Lemon Squeezy → Settings → API, Stores, Webhooks)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# The variant of your "Pro" product priced at $9/month
LEMONSQUEEZY_VARIANT_ID=
# Signing secret of the webhook pointing at https://<your-app>/api/billing/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=

# Custom domains (Pro): Vercel → Account Settings → Tokens; Project → Settings → General for the project id
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Only if the Vercel project belongs to a team
VERCEL_TEAM_ID=
# Optional: extra hosts that serve the app itself (comma-separated), besides *.vercel.app and NEXT_PUBLIC_BASE_URL
APP_HOSTS=

# Optional: GitHub token (no scopes needed) so pasted repo links can show live stars.
# Without it GitHub allows only 60 lookups per hour per server.
GITHUB_TOKEN=

# Optional: only used by the legacy Redis storage helper in src/lib/storage.ts
REDIS_URL=
