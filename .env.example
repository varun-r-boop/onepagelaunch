# Copy to .env.local and fill in your values. Never commit .env.local.

# Supabase: Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only admin key. Keep secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app, used to build page links returned by the API
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: only used by the legacy Redis storage helper in src/lib/storage.ts
REDIS_URL=
